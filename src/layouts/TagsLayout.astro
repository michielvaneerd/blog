---
const { tags } = Astro.props;
---

<ul class="article-tags">
    {
        tags &&
            tags.map(function (tag: string) {
                return (
                    <li>
                        <a href={`${import.meta.env.BASE_URL}/tags/${tag}`}>
                            {tag}
                        </a>
                    </li>
                );
            })
    }
</ul>
