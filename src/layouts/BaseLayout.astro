---
import "../styles/global.css";
const { pageTitle } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="author" content="Michiel van Eerd" />
        <link
            rel="icon"
            href=`${import.meta.env.BASE_URL}/favicon.svg`
            type="image/svg+xml"
        />
        <title>{pageTitle}</title>
        <link
            href=`${import.meta.env.BASE_URL}/pagefind/pagefind-component-ui.css`
            rel="stylesheet"
        />
        <script
            is:inline
            src=`${import.meta.env.BASE_URL}/pagefind/pagefind-component-ui.js`
            type="module"></script>
    </head>
    <body>
        <header>
            <h1>Website</h1>
        </header>
        <nav>
            <ul>
                <li><a href=`${import.meta.env.BASE_URL}/posts`>Home</a></li>
                <li><a href=`${import.meta.env.BASE_URL}/tags`>Tags</a></li>
            </ul>
            <div class="search-box">
                <pagefind-config
                    bundle-path=`${import.meta.env.BASE_URL}/pagefind/`
                ></pagefind-config>
                <pagefind-modal-trigger></pagefind-modal-trigger>
                <pagefind-modal></pagefind-modal>
            </div>
        </nav>
        <main>
            <article>
                <slot />
            </article>
        </main>
        <footer></footer>
    </body>
</html>
